#!/usr/bin/env bash
# shellcheck disable=SC2016 # sh -lc snippets intentionally expand positional args inside the spawned shell.
set -euo pipefail

TERMINAL_CMD="${NIRI_HERMES_TERMINAL:-}"
INTERACTIVE_TERMINAL="${NIRI_HERMES_INTERACTIVE_TERMINAL:-}"
HERMES_RIO_APP_ID="${NIRI_HERMES_RIO_APP_ID:-niri-hermes-rio}"
HERMES_ALACRITTY_CLASS="${NIRI_HERMES_ALACRITTY_CLASS:-niri-hermes-alacritty}"
AGENT_RUNNER="${NIRI_AGENT_RUNNER:-$HOME/.local/bin/niri-agent-run}"
CONFIG_DIR="${NIRI_CONTROL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/niri-control-center}"
WOFI_STYLE="${NIRI_CONTROL_WOFI_STYLE:-$CONFIG_DIR/wofi-glass.css}"
WOFI_CONF="${NIRI_CONTROL_WOFI_CONF:-$CONFIG_DIR/wofi-glass.conf}"
WOFI_BASE_ARGS=()
[[ -f "$WOFI_CONF" ]] && WOFI_BASE_ARGS+=(--conf "$WOFI_CONF")
[[ -f "$WOFI_STYLE" ]] && WOFI_BASE_ARGS+=(--style "$WOFI_STYLE")
WOFI_BASE_ARGS+=(--gtk-dark)

PROMPT='AI Native · Hermes / Codex / Niri context'

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Niri Hermes" "$1" "${2:-}" >/dev/null 2>&1 || true
  fi
}

emit_effect() {
  printf 'effect'
  local part
  for part in "$@"; do
    printf '\t%s' "$part"
  done
  printf '\n'
}

emit_state() {
  printf 'state\t%s\n' "$1"
}

resolve_hermes() {
  if [[ -n "${NIRI_HERMES_CMD:-}" && -x "${NIRI_HERMES_CMD:-}" ]]; then
    printf '%s\n' "$NIRI_HERMES_CMD"
  elif command -v hermes >/dev/null 2>&1; then
    command -v hermes
  elif [[ -x "$HOME/.hermes/hermes-agent/venv/bin/hermes" ]]; then
    printf '%s\n' "$HOME/.hermes/hermes-agent/venv/bin/hermes"
  else
    return 1
  fi
}

resolve_runner() {
  if [[ -x "$AGENT_RUNNER" ]]; then
    printf '%s\n' "$AGENT_RUNNER"
  elif command -v niri-agent-run >/dev/null 2>&1; then
    command -v niri-agent-run
  else
    return 1
  fi
}

resolve_codex() {
  if [[ -n "${NIRI_CODEX_CMD:-}" && -x "${NIRI_CODEX_CMD:-}" ]]; then
    printf '%s\n' "$NIRI_CODEX_CMD"
  elif command -v codex >/dev/null 2>&1; then
    command -v codex
  else
    return 1
  fi
}

choose_terminal() {
  local requested="${1:-}"
  if [[ -n "$requested" ]] && command -v "$requested" >/dev/null 2>&1; then
    printf '%s\n' "$requested"
    return 0
  fi
  for candidate in alacritty rio ghostty xterm; do
    if command -v "$candidate" >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

spawn_terminal() {
  local title="$1"
  shift
  local terminal
  terminal="$(choose_terminal "$TERMINAL_CMD")" || {
    notify "Hermes" "No supported terminal found"
    return 1
  }

  case "$(basename "$terminal")" in
    alacritty)
      "$terminal" --class "$HERMES_ALACRITTY_CLASS,$HERMES_ALACRITTY_CLASS" --title "$title" -e "$@" >/dev/null 2>&1 &
      ;;
    rio)
      "$terminal" --app-id "$HERMES_RIO_APP_ID" --title-placeholder "$title" -e "$@" >/dev/null 2>&1 &
      ;;
    ghostty)
      "$terminal" --class="$HERMES_RIO_APP_ID" -e "$@" >/dev/null 2>&1 &
      ;;
    *)
      "$terminal" -e "$@" >/dev/null 2>&1 &
      ;;
  esac
}

menu_items() {
  cat <<'MENU'
󰚩  AI · Open interactive Hermes TUI  · PTY native terminal
󰭹  AI · Ask Hermes one-shot  · Wofi native input
󰈈  Niri+AI · Explain focused window state
󰣐  AI · Run Codex exec  · notify on finish
󰍹  Wayland+AI · Screenshot workflow advisor
󰑐  Hermes · Status
󰒲  Hermes · Doctor
󰈙  Hermes · Sessions
󰘳  Hermes · Skills
MENU
}

reduce_choice() {
  local choice="$1"
  case "$choice" in
    *"interactive Hermes TUI"*) emit_effect interactive_hermes ;;
    *"Ask Hermes one-shot"*) emit_state ask_hermes_prompt ;;
    *"focused window state"*) emit_effect focused_window_hermes ;;
    *"Codex exec"*) emit_state codex_prompt ;;
    *"Screenshot workflow"*) emit_effect screenshot_workflow_hermes ;;
    *"Hermes · Status"*) emit_effect hermes_cli "Hermes Status" status --all ;;
    *"Hermes · Doctor"*) emit_effect hermes_cli "Hermes Doctor" doctor ;;
    *"Hermes · Sessions"*) emit_effect hermes_cli "Hermes Sessions" sessions list ;;
    *"Hermes · Skills"*) emit_effect hermes_cli "Hermes Skills" skills list ;;
    ''|*) emit_effect noop ;;
  esac
}

ask_prompt() {
  printf '' | wofi "${WOFI_BASE_ARGS[@]}" --dmenu --prompt "AI Native · ask Hermes" --width 780 --height 160 --lines 1 --exec-search || true
}

codex_prompt() {
  printf '' | wofi "${WOFI_BASE_ARGS[@]}" --dmenu --prompt "AI Native · Codex task" --width 840 --height 160 --lines 1 --exec-search || true
}

spawn_interactive_hermes() {
  local hermes terminal runner
  hermes="$(resolve_hermes)" || {
    notify "Hermes not found" "Set NIRI_HERMES_CMD=/path/to/hermes"
    return 1
  }
  runner="$(resolve_runner)" || {
    notify "Agent runner not found" "Install niri-agent-run"
    return 1
  }
  terminal="$(choose_terminal "$INTERACTIVE_TERMINAL")" || {
    notify "Hermes" "No supported terminal found"
    return 1
  }

  case "$(basename "$terminal")" in
    alacritty)
      "$terminal" --class "$HERMES_ALACRITTY_CLASS,$HERMES_ALACRITTY_CLASS" --title "Hermes Agent" --hold -e sh -lc 'exec "$1" --title "Hermes interactive" -- "$2" --tui chat' sh "$runner" "$hermes" >/dev/null 2>&1 &
      ;;
    rio)
      "$terminal" --app-id "$HERMES_RIO_APP_ID" --title-placeholder "Hermes Agent" -e sh -lc 'exec "$1" --title "Hermes interactive" -- "$2" --tui chat' sh "$runner" "$hermes" >/dev/null 2>&1 &
      ;;
    ghostty)
      "$terminal" --class="$HERMES_RIO_APP_ID" -e sh -lc 'exec "$1" --title "Hermes interactive" -- "$2" --tui chat' sh "$runner" "$hermes" >/dev/null 2>&1 &
      ;;
    *)
      "$terminal" -e sh -lc 'exec "$1" --title "Hermes interactive" -- "$2" --tui chat' sh "$runner" "$hermes" >/dev/null 2>&1 &
      ;;
  esac
  notify "Hermes" "Interactive terminal opened via $(basename "$terminal"); exit will notify"
}

run_hermes_result_window() {
  local title="$1"
  local prompt="$2"
  local hermes runner
  hermes="$(resolve_hermes)" || {
    notify "Hermes not found" "Set NIRI_HERMES_CMD=/path/to/hermes"
    return 1
  }
  runner="$(resolve_runner)" || {
    notify "Agent runner not found" "Install niri-agent-run"
    return 1
  }
  spawn_terminal "$title" sh -lc 'printf "%s\n\n" "$3"; "$1" --title "$2" -- "$4" chat -q "$5"; printf "\nPress Enter to close..."; read -r _' sh "$runner" "$title" "$title" "$hermes" "$prompt"
}

run_codex_result_window() {
  local task="$1"
  local codex runner
  codex="$(resolve_codex)" || {
    notify "Codex not found" "Install codex CLI or set NIRI_CODEX_CMD"
    return 1
  }
  runner="$(resolve_runner)" || {
    notify "Agent runner not found" "Install niri-agent-run"
    return 1
  }
  spawn_terminal "Codex exec" sh -lc 'printf "%s\n\n" "Codex task: $4"; "$1" --title "Codex exec" -- "$2" exec "$4"; printf "\nPress Enter to close..."; read -r _' sh "$runner" "$codex" "Codex exec" "$task"
  notify "Codex" "Task started; completion notification enabled"
}

run_hermes_cli() {
  local title="$1"
  shift
  local hermes
  hermes="$(resolve_hermes)" || {
    notify "Hermes not found" "Set NIRI_HERMES_CMD=/path/to/hermes"
    return 1
  }
  if [[ "$title" == "Hermes Status" ]]; then
    spawn_terminal "$title" sh -lc '"$1" status --all 2>/dev/null || "$1" status; printf "\nPress Enter to close..."; read -r _' sh "$hermes"
  else
    spawn_terminal "$title" sh -lc '"$1" "${@:2}"; printf "\nPress Enter to close..."; read -r _' sh "$hermes" "$@"
  fi
}

run_effect() {
  local encoded="$1"
  local -a parts=()
  IFS=$'\t' read -r -a parts <<< "$encoded"
  [[ "${parts[0]:-}" == "effect" ]] || return 0
  case "${parts[1]:-noop}" in
    interactive_hermes) spawn_interactive_hermes ;;
    focused_window_hermes)
      local info
      info="$(niri msg focused-window 2>/dev/null || true)"
      [[ -z "$info" ]] && info="No focused window detected."
      run_hermes_result_window "Hermes focused window" "Explain this Niri focused-window state and suggest useful next window-management action:\n\n$info"
      notify "Hermes" "Focused window sent; completion notification enabled"
      ;;
    screenshot_workflow_hermes)
      run_hermes_result_window "Hermes screenshot workflow" "For my Niri Wayland desktop, suggest a polished screenshot workflow using niri screenshot actions, grim, wl-copy, slurp/swappy if installed, and explain required packages."
      ;;
    hermes_cli) run_hermes_cli "${parts[2]}" "${parts[@]:3}" ;;
    noop) : ;;
  esac
}

main_menu() {
  local choice transition prompt task
  choice="$(menu_items | wofi "${WOFI_BASE_ARGS[@]}" --dmenu --prompt "$PROMPT" --width 840 --height 520 --lines 11 --insensitive --no-custom-entry)" || exit 0
  transition="$(reduce_choice "$choice")"
  case "$transition" in
    $'state\task_hermes_prompt')
      prompt="$(ask_prompt)"
      [[ -z "$prompt" ]] && exit 0
      run_hermes_result_window "Hermes one-shot" "$prompt"
      notify "Hermes" "Question sent; completion notification enabled"
      ;;
    $'state\tcodex_prompt')
      task="$(codex_prompt)"
      [[ -z "$task" ]] && exit 0
      run_codex_result_window "$task"
      ;;
    *) run_effect "$transition" ;;
  esac
}

case "${1:-}" in
  --prompt) printf '%s\n' "$PROMPT" ;;
  --menu-items) menu_items ;;
  --reduce-choice) reduce_choice "${2:-}" ;;
  *) main_menu ;;
esac
