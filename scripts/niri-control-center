#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="${NIRI_CONTROL_BIN_DIR:-$HOME/.local/bin}"
CONFIG_DIR="${NIRI_CONTROL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/niri-control-center}"
CONFIG_FILE="$CONFIG_DIR/config"
WOFI_STYLE="${NIRI_CONTROL_WOFI_STYLE:-$CONFIG_DIR/wofi-glass.css}"
WOFI_CONF="${NIRI_CONTROL_WOFI_CONF:-$CONFIG_DIR/wofi-glass.conf}"
WOFI_BASE_ARGS=()
[[ -f "$WOFI_CONF" ]] && WOFI_BASE_ARGS+=(--conf "$WOFI_CONF")
[[ -f "$WOFI_STYLE" ]] && WOFI_BASE_ARGS+=(--style "$WOFI_STYLE")
WOFI_BASE_ARGS+=(--gtk-dark)

config_language() {
  if [[ -n "${NIRI_CONTROL_LANGUAGE:-}" ]]; then
    printf '%s\n' "$NIRI_CONTROL_LANGUAGE"
    return 0
  fi
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    . "$CONFIG_FILE" 2>/dev/null || true
  fi
  printf '%s\n' "${language:-auto}"
}

system_language() {
  local raw="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
  case "$raw" in
    ko*|KO*) printf 'ko\n' ;;
    *) printf 'en\n' ;;
  esac
}

active_language() {
  local configured
  configured="$(config_language)"
  case "$configured" in
    ko|en) printf '%s\n' "$configured" ;;
    *) system_language ;;
  esac
}

write_language() {
  local value="$1"
  mkdir -p "$CONFIG_DIR"
  printf 'language=%s\n' "$value" > "$CONFIG_FILE"
}

LANGUAGE="$(active_language)"

i18n() {
  local key="$1"
  case "$LANGUAGE:$key" in
    ko:prompt) printf 'Niri Command · 네이티브 액션, 앱, 에이전트' ;;
    ko:launch_app) printf 'App · 앱 실행 / 검색' ;;
    ko:hermes) printf 'AI · Hermes Agent' ;;
    ko:scratch) printf 'Niri · 스크래치 터미널' ;;
    ko:hud) printf 'Niri · 포커스 창 HUD' ;;
    ko:wallpaper) printf 'Wayland · 배경화면 전환' ;;
    ko:power_menu) printf 'System · 전원 / 세션 메뉴' ;;
    ko:overview) printf 'Niri · 오버뷰 켜기/끄기' ;;
    ko:transition) printf 'Niri · 시네마틱 화면 전환' ;;
    ko:cheatsheet) printf 'Niri · 단축키 오버레이' ;;
    ko:opacity) printf 'Niri · 창 투명도 규칙 토글' ;;
    ko:floating) printf 'Niri · 플로팅 / 타일링 토글' ;;
    ko:focus_floating) printf 'Niri · 플로팅 레이어 포커스' ;;
    ko:focus_tiling) printf 'Niri · 타일링 레이어 포커스' ;;
    ko:move_floating) printf 'Niri · 창을 플로팅으로 이동' ;;
    ko:move_tiling) printf 'Niri · 창을 타일링으로 이동' ;;
    ko:switch_focus) printf 'Niri · 플로팅 ↔ 타일링 포커스 전환' ;;
    ko:tabbed) printf 'Niri · 탭 컬럼 토글' ;;
    ko:max_column) printf 'Niri · 컬럼 최대화' ;;
    ko:max_window) printf 'Niri · 창을 화면 가장자리까지 최대화' ;;
    ko:center_window) printf 'Niri · 창 가운데 정렬' ;;
    ko:center_columns) printf 'Niri · 보이는 컬럼 가운데 정렬' ;;
    ko:consume_left) printf 'Niri · 왼쪽 창 흡수 / 배출' ;;
    ko:consume_right) printf 'Niri · 오른쪽 창 흡수 / 배출' ;;
    ko:expel) printf 'Niri · 컬럼에서 창 배출' ;;
    ko:cast_window) printf 'Wayland · 캐스트 대상: 현재 창' ;;
    ko:cast_monitor) printf 'Wayland · 캐스트 대상: 현재 모니터' ;;
    ko:clear_cast) printf 'Wayland · 캐스트 대상 지우기' ;;
    ko:stop_cast) printf 'Wayland · 스크린캐스트 중지' ;;
    ko:switch_keyboard) printf 'Input · 키보드 레이아웃 전환' ;;
    ko:screenshot) printf 'Wayland · 스크린샷 UI' ;;
    ko:quick_status) printf 'Niri · 빠른 상태를 터미널에서 보기' ;;
    ko:reload) printf 'Niri · 설정 다시 불러오기' ;;
    ko:language) printf 'Control · 언어 설정' ;;
    ko:monitors_off) printf 'System · 모니터 전원 끄기' ;;
    ko:app_prompt) printf '앱 실행' ;;
    ko:language_prompt) printf '언어 / Language' ;;
    ko:auto_lang) printf '자동: 시스템 언어 따라가기' ;;
    ko:korean) printf '한국어' ;;
    ko:english) printf 'English' ;;
    ko:language_saved) printf '언어 설정 저장됨' ;;
    ko:auto_saved) printf '시스템 언어를 자동으로 따릅니다' ;;
    ko:unknown_search) printf '앱 검색' ;;
    ko:unknown_body) printf '입력한 이름으로 앱 런처를 엽니다' ;;
    en:prompt) printf 'Niri Command · native actions, apps, agents' ;;
    en:launch_app) printf 'App · Launch / search app' ;;
    en:hermes) printf 'AI · Hermes Agent' ;;
    en:scratch) printf 'Niri · Scratch terminal' ;;
    en:hud) printf 'Niri · Focused window HUD' ;;
    en:wallpaper) printf 'Wayland · Wallpaper transition' ;;
    en:power_menu) printf 'System · Power / session menu' ;;
    en:overview) printf 'Niri · Toggle overview' ;;
    en:transition) printf 'Niri · Cinematic transition' ;;
    en:cheatsheet) printf 'Niri · Hotkey overlay' ;;
    en:opacity) printf 'Niri · Toggle window opacity rule' ;;
    en:floating) printf 'Niri · Toggle floating / tiling' ;;
    en:focus_floating) printf 'Niri · Focus floating layer' ;;
    en:focus_tiling) printf 'Niri · Focus tiling layer' ;;
    en:move_floating) printf 'Niri · Move window to floating' ;;
    en:move_tiling) printf 'Niri · Move window to tiling' ;;
    en:switch_focus) printf 'Niri · Switch focus floating ↔ tiling' ;;
    en:tabbed) printf 'Niri · Toggle tabbed column' ;;
    en:max_column) printf 'Niri · Maximize column' ;;
    en:max_window) printf 'Niri · Maximize window to edges' ;;
    en:center_window) printf 'Niri · Center window' ;;
    en:center_columns) printf 'Niri · Center visible columns' ;;
    en:consume_left) printf 'Niri · Consume / expel left' ;;
    en:consume_right) printf 'Niri · Consume / expel right' ;;
    en:expel) printf 'Niri · Expel window from column' ;;
    en:cast_window) printf 'Wayland · Set cast target: focused window' ;;
    en:cast_monitor) printf 'Wayland · Set cast target: focused monitor' ;;
    en:clear_cast) printf 'Wayland · Clear cast target' ;;
    en:stop_cast) printf 'Wayland · Stop screencast' ;;
    en:switch_keyboard) printf 'Input · Switch keyboard layout' ;;
    en:screenshot) printf 'Wayland · Screenshot UI' ;;
    en:quick_status) printf 'Niri · Quick status in terminal' ;;
    en:reload) printf 'Niri · Reload config' ;;
    en:language) printf 'Control · Language' ;;
    en:monitors_off) printf 'System · Power off monitors' ;;
    en:app_prompt) printf 'Launch app' ;;
    en:language_prompt) printf 'Language / 언어' ;;
    en:auto_lang) printf 'Auto: follow system language' ;;
    en:korean) printf '한국어' ;;
    en:english) printf 'English' ;;
    en:language_saved) printf 'Language saved' ;;
    en:auto_saved) printf 'Following the system language automatically' ;;
    en:unknown_search) printf 'App search' ;;
    en:unknown_body) printf 'Opening the app launcher with your search text' ;;
    *) printf '%s' "$key" ;;
  esac
}

menu_items() {
  cat <<MENU
󰀻  $(i18n launch_app)
󰚩  $(i18n hermes)
󰆍  $(i18n scratch)
󰋼  $(i18n hud)
󰸉  $(i18n wallpaper)
󰐥  $(i18n power_menu)
󰈈  $(i18n overview)
󰐊  $(i18n transition)
󰌾  $(i18n cheatsheet)
󰆾  $(i18n opacity)
󰉈  $(i18n floating)
󰹑  $(i18n focus_floating)
󰹒  $(i18n focus_tiling)
󰜺  $(i18n move_floating)
󰜻  $(i18n move_tiling)
󰹕  $(i18n switch_focus)
󰘖  $(i18n tabbed)
󰹖  $(i18n max_column)
󰹗  $(i18n max_window)
󰹘  $(i18n center_window)
󰹙  $(i18n center_columns)
󰁌  $(i18n consume_left)
󰁔  $(i18n consume_right)
󰹚  $(i18n expel)
󰔬  $(i18n cast_window)
󰔭  $(i18n cast_monitor)
󰅖  $(i18n clear_cast)
󰓛  $(i18n stop_cast)
󰌌  $(i18n switch_keyboard)
󰍹  $(i18n screenshot)
󰹛  $(i18n quick_status)
󰑐  $(i18n reload)
󰅶  $(i18n language)
⏻  $(i18n monitors_off)
MENU
}

language_items() {
  printf '%s\n%s\n%s\n' "$(i18n auto_lang)" "$(i18n korean)" "$(i18n english)"
}

notify_user() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Niri Control" "$1" "${2:-}" >/dev/null 2>&1 || true
  fi
}

emit_effect() {
  printf 'effect'
  local part
  for part in "$@"; do
    printf '\t%s' "$part"
  done
  printf '\n'
}

emit_state() {
  printf 'state\t%s\n' "$1"
}

reduce_menu_choice() {
  local choice="$1"
  case "$choice" in
    *"$(i18n launch_app)"*) emit_effect launch_app ;;
    *"$(i18n hermes)"*) emit_effect spawn_script niri-hermes-menu ;;
    *"$(i18n scratch)"*) emit_effect spawn_script niri-scratch-terminal ;;
    *"$(i18n hud)"*) emit_effect spawn_script niri-window-hud ;;
    *"$(i18n wallpaper)"*) emit_effect spawn_script niri-wallpaper-shuffle ;;
    *"$(i18n power_menu)"*) emit_effect spawn_script niri-power-menu ;;
    *"$(i18n overview)"*) emit_effect niri_action "$(i18n overview)" toggle-overview ;;
    *"$(i18n transition)"*) emit_effect niri_action "$(i18n transition)" do-screen-transition --delay-ms 140 ;;
    *"$(i18n cheatsheet)"*) emit_effect niri_action "$(i18n cheatsheet)" show-hotkey-overlay ;;
    *"$(i18n opacity)"*) emit_effect niri_action "$(i18n opacity)" toggle-window-rule-opacity ;;
    *"$(i18n floating)"*) emit_effect niri_action "$(i18n floating)" toggle-window-floating ;;
    *"$(i18n focus_floating)"*) emit_effect niri_action "$(i18n focus_floating)" focus-floating ;;
    *"$(i18n focus_tiling)"*) emit_effect niri_action "$(i18n focus_tiling)" focus-tiling ;;
    *"$(i18n move_floating)"*) emit_effect niri_action "$(i18n move_floating)" move-window-to-floating ;;
    *"$(i18n move_tiling)"*) emit_effect niri_action "$(i18n move_tiling)" move-window-to-tiling ;;
    *"$(i18n switch_focus)"*) emit_effect niri_action "$(i18n switch_focus)" switch-focus-between-floating-and-tiling ;;
    *"$(i18n tabbed)"*) emit_effect niri_action "$(i18n tabbed)" toggle-column-tabbed-display ;;
    *"$(i18n max_column)"*) emit_effect niri_action "$(i18n max_column)" maximize-column ;;
    *"$(i18n max_window)"*) emit_effect niri_action "$(i18n max_window)" maximize-window-to-edges ;;
    *"$(i18n center_window)"*) emit_effect niri_action "$(i18n center_window)" center-window ;;
    *"$(i18n center_columns)"*) emit_effect niri_action "$(i18n center_columns)" center-visible-columns ;;
    *"$(i18n consume_left)"*) emit_effect niri_action "$(i18n consume_left)" consume-or-expel-window-left ;;
    *"$(i18n consume_right)"*) emit_effect niri_action "$(i18n consume_right)" consume-or-expel-window-right ;;
    *"$(i18n expel)"*) emit_effect niri_action "$(i18n expel)" expel-window-from-column ;;
    *"$(i18n cast_window)"*) emit_effect niri_action "$(i18n cast_window)" set-dynamic-cast-window ;;
    *"$(i18n cast_monitor)"*) emit_effect niri_action "$(i18n cast_monitor)" set-dynamic-cast-monitor ;;
    *"$(i18n clear_cast)"*) emit_effect niri_action "$(i18n clear_cast)" clear-dynamic-cast-target ;;
    *"$(i18n stop_cast)"*) emit_effect niri_action "$(i18n stop_cast)" stop-cast ;;
    *"$(i18n switch_keyboard)"*) emit_effect niri_action "$(i18n switch_keyboard)" switch-layout ;;
    *"$(i18n screenshot)"*) emit_effect niri_action "$(i18n screenshot)" screenshot ;;
    *"$(i18n quick_status)"*) emit_effect show_info ;;
    *"$(i18n reload)"*) emit_effect niri_action "$(i18n reload)" load-config-file ;;
    *"$(i18n language)"*) emit_state language_menu ;;
    *"$(i18n monitors_off)"*) emit_effect niri_action "$(i18n monitors_off)" power-off-monitors ;;
    '') emit_effect noop ;;
    *) emit_effect launch_app_search "$choice" ;;
  esac
}

reduce_language_choice() {
  local choice="$1"
  case "$choice" in
    *"Auto"*|*"자동"*) emit_effect write_language auto ;;
    *"한국어"*) emit_effect write_language ko ;;
    *"English"*) emit_effect write_language en ;;
    '') emit_effect noop ;;
    *) emit_effect noop ;;
  esac
}

reduce_state() {
  local state="$1"
  local event="$2"
  case "$state" in
    menu) reduce_menu_choice "$event" ;;
    language_menu) reduce_language_choice "$event" ;;
    *) emit_effect noop ;;
  esac
}

run_niri_action() {
  local label="$1"
  shift
  niri msg action "$@"
  notify_user "$label" "niri msg action $*"
}

show_info() {
  local tmp
  tmp="$(mktemp)"
  {
    printf 'Niri quick status\n\n'
    niri msg outputs 2>/dev/null | sed -n '1,120p'
    printf '\n--- Focused Window ---\n'
    niri msg focused-window 2>/dev/null || true
    printf '\n--- Layers ---\n'
    niri msg layers 2>/dev/null | grep -E 'Output |Namespace|Background layer|Top layer|Overlay layer|Bottom layer' | sed -n '1,120p' || true
  } > "$tmp"
  if command -v rio >/dev/null 2>&1; then
    rio --app-id niri-status-rio --title-placeholder "Niri Status" -e sh -c "less -R '$tmp'; rm -f '$tmp'" >/dev/null 2>&1 &
  else
    ${TERMINAL:-xterm} -e sh -c "less -R '$tmp'; rm -f '$tmp'" >/dev/null 2>&1 &
  fi
}

launch_app() {
  wofi "${WOFI_BASE_ARGS[@]}" --show drun \
    --prompt "$(i18n app_prompt)" \
    --width 760 \
    --height 620 \
    --lines 16 \
    --insensitive \
    --allow-images >/dev/null 2>&1 &
}

launch_app_search() {
  local query="$1"
  wofi "${WOFI_BASE_ARGS[@]}" --show drun \
    --prompt "$(i18n app_prompt)" \
    --search "$query" \
    --width 760 \
    --height 620 \
    --lines 16 \
    --insensitive \
    --allow-images >/dev/null 2>&1 &
}

run_effect() {
  local encoded="$1"
  local -a parts=()
  local kind
  local effect
  IFS=$'\t' read -r -a parts <<< "$encoded"
  kind="${parts[0]:-}"
  effect="${parts[1]:-noop}"
  [[ "$kind" == "effect" ]] || return 0
  case "$effect" in
    launch_app) launch_app ;;
    launch_app_search)
      notify_user "$(i18n unknown_search)" "$(i18n unknown_body): ${parts[2]:-}"
      launch_app_search "${parts[2]:-}"
      ;;
    spawn_script) "$BIN_DIR/${parts[2]}" ;;
    niri_action) run_niri_action "${parts[2]}" "${parts[@]:3}" ;;
    show_info) show_info ;;
    write_language)
      write_language "${parts[2]:-auto}"
      case "${parts[2]:-auto}" in
        auto) notify_user "$(i18n language_saved)" "$(i18n auto_saved)" ;;
        ko) notify_user "$(i18n language_saved)" "한국어" ;;
        en) notify_user "$(i18n language_saved)" "English" ;;
      esac
      ;;
    noop) : ;;
  esac
}

open_language_menu() {
  local choice
  choice="$(language_items | wofi "${WOFI_BASE_ARGS[@]}" --dmenu --prompt "$(i18n language_prompt)" --width 560 --height 230 --lines 3 --insensitive --no-custom-entry)" || return 0
  run_effect "$(reduce_state language_menu "$choice")"
}

main_menu() {
  local choice
  local transition
  choice="$(menu_items | wofi "${WOFI_BASE_ARGS[@]}" --dmenu --prompt "$(i18n prompt)" --width 900 --height 720 --lines 22 --insensitive)" || exit 0
  transition="$(reduce_state menu "$choice")"
  case "$transition" in
    $'state\tlanguage_menu') open_language_menu ;;
    *) run_effect "$transition" ;;
  esac
}

self_test() {
  command -v wofi >/dev/null
  command -v niri >/dev/null
  test -x "$BIN_DIR/niri-hermes-menu"
  test -x "$BIN_DIR/niri-agent-run"
  test -x "$BIN_DIR/niri-scratch-terminal"
  test -x "$BIN_DIR/niri-window-hud"
  test -x "$BIN_DIR/niri-power-menu"
  test -x "$BIN_DIR/niri-wallpaper-shuffle"
}

case "${1:-}" in
  --self-test) self_test ;;
  --prompt) i18n prompt; printf '\n' ;;
  --menu-items) menu_items ;;
  --language-items) language_items ;;
  --reduce-choice) reduce_state menu "${2:-}" ;;
  --state) reduce_state "${2:-menu}" "${3:-}" ;;
  *) main_menu ;;
esac
